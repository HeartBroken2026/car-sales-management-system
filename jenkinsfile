pipeline {
    agent any

    environment {
        // Name of the docker image
        DOCKER_IMAGE_NAME = 'car-sales-management-system'
        DOCKER_TAG = "build-${env.BUILD_ID}"
        // Port mapping for the container (Host:Container)
        HOST_PORT = '8081'
    }

    stages {
        stage('Checkout') {
            steps {
                // Checkout the git repository
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker Image: ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}"
                    // Assuming Docker is available on the Jenkins agent (Windows)
                    bat "docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} -t ${DOCKER_IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Test Configuration') {
            steps {
                script {
                    echo "Validating Nginx configuration within the built image..."
                    // Start container temporarily to test syntax
                    bat "docker run --rm ${DOCKER_IMAGE_NAME}:latest nginx -t"
                }
            }
        }

        stage('Deploy Container') {
            steps {
                script {
                    echo "Stopping and removing existing container if running..."
                    bat "docker rm -f ${DOCKER_IMAGE_NAME}_app || exit 0"

                    echo "Starting new container on port ${HOST_PORT}..."
                    bat "docker run -d -p ${HOST_PORT}:80 --name ${DOCKER_IMAGE_NAME}_app ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}"
                }
            }
        }
    }

    post {
        success {
            echo "Successfully deployed the container. The application is running on port ${HOST_PORT}."
        }
        failure {
            echo "Pipeline failed. Please review the logs above."
        }
    }
}